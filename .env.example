# Copy to .env.local for local overrides, and set the same values on the host
# (Netlify: Site configuration → Environment variables; Vercel: Project →
# Settings → Environment Variables). Redeploy after changing NEXT_PUBLIC_ values.

# The live address, used for canonical links, the sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://blissdigital.id

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=

# Keystatic on the live site: the GitHub repository it saves to, as owner/name.
# Leave empty and the editor only saves on your own computer (npm run dev).
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Filled in by Keystatic's GitHub setup (see README). Keep these secret.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
